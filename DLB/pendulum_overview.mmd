flowchart LR
    PC["上位机 FPGA Monitor<br/>UART 115200 / 8N1"]
    KEYS["实体按键 K1 / K2 / K3<br/>K4 未使用"]
    CHIP["ADC128S102 芯片<br/>摆角模拟输入 CH0"]
    ENC["电机编码器<br/>A / B 两相"]
    BOARD["TB6612 芯片"]
    PLANT["电机、横杆与摆杆<br/>实际机械系统"]
    DISPLAY["8位数码管及移位寄存器"]

    subgraph FPGA["FPGA 顶层 Test.v：全部模块使用 50 MHz；rst_n 低有效复位"]
        direction TB

        subgraph INPUT["输入模块"]
            KEY["RTL：key × 3<br/>消抖并产生单次 key_press"]
            ADC["RTL：adc128s102<br/>SPI采样；输出 adc_data / adc_valid"]
            QUAD["RTL：encoder_quad<br/>同步、AB四倍频解码<br/>输出 position_cnt"]
        end

        subgraph CONTROL["Test.v 内部：定时、目标、起摆及保护"]
            TIME["控制逻辑：计时与调度<br/>50 MHz → 1 ms使能<br/>5 / 40 / 50 / 20 ms调度"]
            GOAL["控制逻辑：位置目标 target_position<br/>K1：+34；K2：-34<br/>限幅 ±4080；启动和捕获不修改goal"]
            FSM["控制逻辑：自动起摆状态机<br/>0停止；1判断；21～24 / 31～34施力；4稳摆<br/>双向35%脉冲，每段100 ms<br/>40 ms三点峰值判断；连续两次进入中心区间后捕获"]
            ORIGIN["控制逻辑：position_offset<br/>仅K3由停止切换到启动时记录 position_cnt<br/>捕获和停止保留；再次启动记录新的起点"]
            REAL["控制逻辑：相对位置与饱和<br/>p_real = position_cnt - position_offset<br/>超出INT32范围时饱和；包含起摆位移"]
            ENABLE["控制逻辑：传感器保护与输出使能<br/>ADC采样超时约3 ms：停机<br/>中心区间：1560 &lt; ADC &lt; 2560<br/>稳摆越界或K3停止：关闭输出<br/>生成 balance_en / motor_en"]
            ACLEAR["控制逻辑：内环 pid_clear<br/>捕获直立 OR a_update"]
            PCLEAR["控制逻辑：外环 pid_clear<br/>捕获清零延后一拍 OR p_update<br/>清PID状态；不改位置零点或goal"]
        end

        subgraph LOOPS["两个独立成品 PID_Core：MyPID.v 保持不变"]
            PSAMPLE["控制层：位置输入采样 / tick<br/>1 ms锁存位置目标及实际位置<br/>每50 ms到期后下一拍触发外环"]
            PPID["RTL：PID_Core / position_pid<br/>外环：位置环<br/>Kp=0.4；Ki=0.016；Kd=4<br/>输出 p_out：角度修正量<br/>输出限幅±100；积分贡献限幅±100"]
            CASCADE["控制层：串级连接<br/>稳摆时 a_goal = 2060 - p_out<br/>停止或起摆时 a_goal = 2060"]
            ASAMPLE["控制层：角度输入采样 / tick<br/>1 ms锁存角度目标及ADC实际值<br/>每5 ms到期后下一拍触发内环"]
            APID["RTL：PID_Core / angle_pid<br/>内环：角度环<br/>Kp=0.3；Ki=0.01；Kd=0.4<br/>输出 a_out：PWM百分比<br/>输出限幅±100；积分贡献限幅±100"]
        end

        subgraph DRIVE["电机输出模块"]
            SELECT["控制逻辑：电机指令选择<br/>停止 / 禁止输出：0<br/>起摆：swing_pwm；稳摆：a_out"]
            SCALE["控制逻辑：PWM单位换算<br/>motor_percent × 25<br/>±100%对应±2500计数"]
            MOTOR["RTL：TB6612_Motor_driver<br/>使能、方向、绝对值和幅值限制<br/>DIR_REVERSE=1；motor_brake=0"]
            PWM["内部例化 RTL：PWM<br/>20 kHz；周期2500计数<br/>产生 tb_pwm"]
        end

        subgraph SERIAL["串口收发与参数管理模块"]
            subgraph RXGROUP["RTL：protocol_rx"]
                RXBYTE["内部例化：uart_byte_rx<br/>串行字节接收"]
                RXPROTO["协议解析 / CRC校验<br/>输出 set_valid、ID、TYPE、VALUE"]
            end
            APARAM["RTL：parameter_manager / angle_parameters<br/>内环ID：0x10 Kp / 0x11 Ki / 0x12 Kd<br/>仅接受Q16.16参数"]
            PPARAM["RTL：parameter_manager / position_parameters<br/>外环ID：0x20 Kp / 0x21 Ki / 0x22 Kd<br/>仅接受Q16.16参数；默认Ki RAW=1049"]
            SNAP["控制逻辑：每20 ms冻结遥测快照<br/>内环：0x01 goal / 0x02 real / 0x03 set<br/>外环：0x04 goal / 0x05 real / 0x06 set<br/>加两环6个Kp / Ki / Kd，共12项<br/>停止和起摆时两环set为0；real持续上传<br/>goal / set的Q格式适配仅在UART边界"]
            MUX["RTL：telemetry_param_mux<br/>按 param_index 选取12项<br/>输出 param_count / ID / TYPE / VALUE"]
            subgraph TXGROUP["RTL：protocol_tx"]
                TXPROTO["Protocol V1组帧 / CRC / 发送状态机<br/>每帧83字节；输出 tx_busy"]
                TXBYTE["内部例化：uart_byte_tx<br/>串行字节发送"]
            end
        end

        subgraph VIEW["本地显示模块"]
            FORMAT["控制逻辑：显示数据组合<br/>左4位状态；右4位相对位置绝对值"]
            SEG["RTL：Seg8<br/>数字转换、扫描及移位发送"]
        end
    end

    KEYS --> KEY
    CHIP -->|ADC_DOUT| ADC
    ADC -->|ADC_SCLK / ADC_DIN / ADC_CS_N| CHIP
    ENC -->|encoder_a / encoder_b| QUAD
    KEY -->|K1 / K2| GOAL
    KEY -.->|K3启动 / 停止| FSM
    KEY -.->|K3停止立即禁止输出| ENABLE
    TIME -.->|1 ms状态计时 / 40 ms判断| FSM
    TIME -.->|1 ms采样 / 5 ms调度| ASAMPLE
    TIME -.->|1 ms采样 / 50 ms调度| PSAMPLE
    TIME -.->|1 ms超时计数| ENABLE
    TIME -.->|20 ms发送机会| SNAP
    ADC -->|角度样本| FSM
    ADC -->|adc_data / adc_valid| ENABLE
    ENABLE -.->|ADC失效或稳摆越界停机| FSM
    FSM -.->|启动事件| ORIGIN
    QUAD -->|启动时累计位置| ORIGIN
    QUAD -->|position_cnt| REAL
    ORIGIN -->|position_offset| REAL
    GOAL -->|p_goal| PSAMPLE
    REAL -->|p_real| PSAMPLE
    PSAMPLE -->|target / feedback| PPID
    PSAMPLE -.->|position_tick| PPID
    PPID -->|p_out| CASCADE
    ENABLE -.->|balance_en| CASCADE
    CASCADE -->|a_goal| ASAMPLE
    ADC -->|adc_data| ASAMPLE
    ASAMPLE -->|target / feedback| APID
    ASAMPLE -.->|angle_tick| APID
    FSM -.->|运行状态| ENABLE
    ENABLE -.->|balance_en| PPID
    ENABLE -.->|balance_en| APID
    FSM -.->|捕获直立| ACLEAR
    FSM -.->|捕获直立| PCLEAR
    ACLEAR -.->|pid_clear| APID
    PCLEAR -.->|pid_clear| PPID
    FSM -->|run_state / swing_pwm| SELECT
    APID -->|a_out| SELECT
    ENABLE -.->|motor_en| SELECT
    SELECT -->|motor_percent| SCALE
    SCALE -->|有符号PWM计数| MOTOR
    ENABLE -.->|motor_en| MOTOR
    MOTOR -->|duty / enable| PWM
    MOTOR -->|tb_in1 / tb_in2| BOARD
    PWM -->|tb_pwm| BOARD
    BOARD -->|电机驱动| PLANT
    PLANT -->|横杆位置| ENC
    PLANT -->|摆杆角度，经传感器转换| CHIP
    PC -->|uart_rx：六个PID参数命令| RXBYTE
    RXBYTE -->|字节 / 接收完成| RXPROTO
    RXPROTO -->|内环参数命令| APARAM
    RXPROTO -->|外环参数命令| PPARAM
    APARAM -->|a_kp / a_ki / a_kd| APID
    PPARAM -->|p_kp / p_ki / p_kd| PPID
    APARAM -.->|a_update| ACLEAR
    PPARAM -.->|p_update| PCLEAR
    CASCADE -->|a_goal| SNAP
    ADC -->|a_real| SNAP
    APID -->|a_out，经balance_en门控为a_set| SNAP
    GOAL -->|p_goal| SNAP
    REAL -->|p_real| SNAP
    PPID -->|p_out，经balance_en门控为p_set| SNAP
    APARAM -->|内环三参数| SNAP
    PPARAM -->|外环三参数| SNAP
    SNAP -->|冻结的12项| MUX
    SNAP -.->|send_en；忙时跳过本次发送| TXPROTO
    TXPROTO -->|param_index| MUX
    MUX -->|param_count / ID / TYPE / VALUE| TXPROTO
    TXPROTO -.->|tx_busy| SNAP
    TXPROTO -->|待发送字节| TXBYTE
    TXBYTE -->|uart_tx：12项遥测| PC
    FSM -->|run_state| FORMAT
    PSAMPLE -->|position_sample| FORMAT
    FORMAT -->|Data| SEG
    SEG -->|ds / sh_cp / st_cp| DISPLAY

    classDef rtl fill:#dae8fc,stroke:#6c8ebf,color:#111;
    classDef logic fill:#fff2cc,stroke:#d6b656,color:#111;
    classDef pid fill:#d5e8d4,stroke:#82b366,color:#111,stroke-width:2px;
    classDef safety fill:#f8cecc,stroke:#b85450,color:#111;
    classDef external fill:#f5f5f5,stroke:#666666,color:#111;
    class KEY,ADC,QUAD,MOTOR,PWM,RXBYTE,RXPROTO,APARAM,PPARAM,MUX,TXPROTO,TXBYTE,SEG rtl;
    class TIME,GOAL,FSM,ORIGIN,REAL,ACLEAR,PCLEAR,PSAMPLE,CASCADE,ASAMPLE,SELECT,SCALE,SNAP,FORMAT logic;
    class APID,PPID pid;
    class ENABLE safety;
    class PC,KEYS,CHIP,ENC,BOARD,PLANT,DISPLAY external;
