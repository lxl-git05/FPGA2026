//IO_LOC  "led[1]" U19;   IO_PORT "led[1]" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
//IO_LOC  "led[2]" U17;   IO_PORT "led[2]" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
//IO_LOC  "led[3]" T17;   IO_PORT "led[3]" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
//IO_LOC  "clk_27m" B20;  IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
//IO_LOC  "enc2_a"  W18;  IO_PORT "enc2_a"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
//IO_LOC  "enc2_b"  W17;  IO_PORT "enc2_b"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
