// J280 / GW2A-LV55PG484C8/I7
// 50MHz时钟：BANK2，3.3V。
IO_LOC "clk" M19;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// SW5复位：BANK5，3.3V，低有效。
IO_LOC "rst_n" AB3;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// SW1~SW3：BANK3，1.5V，按下为低电平。
IO_LOC "key_in[0]" T18;
IO_PORT "key_in[0]" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "key_in[1]" R18;
IO_PORT "key_in[1]" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "key_in[2]" U20;
IO_PORT "key_in[2]" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// LED1~LED3：BANK3，1.5V，高电平点亮。
IO_LOC "led[0]" U18;
IO_PORT "led[0]" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "led[1]" U19;
IO_PORT "led[1]" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC "led[2]" U17;
IO_PORT "led[2]" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
 