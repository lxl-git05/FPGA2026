// J280：50MHz、SW5低有效复位、USB串口，均为3.3V。
IO_LOC "clk" M19;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "rst_n" AB3;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "uart_tx" K20;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_rx" L20;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 按Balance_Ctrl_20260618原理图：XH1的O1/O2接TB6612 B桥，编码器仍为1A/1B。
// B桥：PWMB=V14，BIN1=AA17，BIN2=V15；BANK4实际跳帽应为3.3V。
IO_LOC "tb_pwm" V14;
IO_PORT "tb_pwm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "tb_in1" AA17;
IO_PORT "tb_in1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tb_in2" V15;
IO_PORT "tb_in2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "encoder_a" Y20;
IO_PORT "encoder_a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "encoder_b" AA20;
IO_PORT "encoder_b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
